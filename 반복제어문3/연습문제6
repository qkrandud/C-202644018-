#include <stdio.h>

int main()
{
    int eng = 97;
    int num = 1;
    for(int i = 1;i <= 4;i++) {
        for(int j = 0;j < i;j++) {
            printf("%c ",eng);
            eng++;
        }
        for(int j = 4;j >= i;j--) {
            printf("%d ",num);
            num++;
        }
        printf("\n");
    }
    return 0;
}
