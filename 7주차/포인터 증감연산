#include <stdio.h>


int main() {
    int i = 10;
    int *p;

    p = &i;

    printf("%d\n",(*p)++);  //현재 값을 반환하고 값에 1을 증가시킨다
    printf("%d\n",(*p) + 1); // 값은 변경되지 않고 값에 1을 증가시킨 것을 반환한다
    printf("%d\n",*p += 1); // 현재 값에 1을 더하고 다시 결과를 저장한다
    printf("%d\n",(*p) += 1); // *p += 1과 똑같다
    printf("%d\n",*p = *p + 1); // 현재 값에 1을 더한 값을 결과에 저장한다
    printf("%d\n",++*p); // 값에 1을 증가시키고 값을 반환한다
    printf("%d\n",++(*p)); //  ++*p 과 연산방식은 똑같지만 연산방식을 명확하게 나타낸것이다

    return 0;
}
