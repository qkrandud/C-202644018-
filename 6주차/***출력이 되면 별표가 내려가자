#include <stdio.h>

int main() {
    for(int i = 1; i<=6;i++) {
        int star;

        // 아직 3번 별표 출력에 도달하지 않았다면
        if(i <= 3) {
            star = i;
        }
        // 3번 출력이 완료됬으면
        else {
            star = 7 - i;
        }
        //별표 출력
        for ( int j = 1;j<=star;j++) {
            printf("*");
        }
        printf("\n");
        return 0;
    }
}
