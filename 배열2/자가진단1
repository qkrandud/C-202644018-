#include <stdio.h>
#include <ctype.h>

int main()
{
    int arr[26] = {0};
    char str1;
    scanf(" %c", &str1);

    for (int i = 0; i < 100; i++)
    {
        if (isupper(str1))
        {
            arr[str1 - 65]++;
        }
        else
        {
            break;
        }
        scanf(" %c", &str1);
    }
    for (int i = 0; i < 26; i++)
    {
        if (arr[i] != 0)
        {
            printf("%c : %d\n", 65 + i, arr[i]);
        }
    }
    return 0;
}
