#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int answer;
    int num;
    int count = 0;

    srand(time(NULL));

    answer = rand() % 100 + 1;

    printf("1부터 100사이에 숫자를 맞춰보세요");

    while(num != answer) {
        printf("숫자 입력 : ");
        scanf("%d", &num);

        if(num < answer) {
            printf("더 작은 수 입니다\n");
        }
        else if(num > answer) {
            printf("더 큰 수 입니다\n");
        }
    }
    printf("같은 수 입니다");
    return 0;
}
