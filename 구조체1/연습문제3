#include <stdio.h>

struct Person
{
    char name[21];
    int age;
};

int main()
{
    struct Person person[3] = {{"", 9}, {"", 20}, {"", 30}};

    for (int i = 0; i < 3; i++)
    {
        scanf("%20s %d", person[i].name, &person[i].age);
        printf("Name : %s\nAge : %d\n", person[i].name, person[i].age);
    }
    return 0;
}
