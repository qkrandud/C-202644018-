#include <stdio.h>

int main()
{
    int n;
    scanf("%d",&n);
    int num = 1;
    char eng = 'A';

    for(int i = 1;i <= n;i++) {
        for(int j = n;j >= i;j--) {
            printf("%d ",num);
            num++;
        }
        for(int j = 0;j < i;j++) {
            printf("%c ",eng);
            eng++;
        }
        printf("\n");
    }
    return 0;
}
