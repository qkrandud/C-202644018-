#include <stdio.h>


struct Person
{
    int x;
    int y;
};


int main()
{
    struct Person p1[2] = { {1, 2}, {3, 4} };

    for(int i = 0; i < 2; i++) {
        scanf("%d %d", &p1[i].x, &p1[i].y);
    }
    float center_x = (p1[0].x + p1[1].x) / 2.0;
    float center_y = (p1[0].y + p1[1].y) / 2.0;
    printf("Center point = (%.1f, %.1f)\n", center_x, center_y);
    return 0;
}
