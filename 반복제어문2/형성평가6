#include <stdio.h>

int main()
{
    int a,b;
    scanf("%d",&a);
    scanf("%d",&b);
    if(a > b) {
        int temp;
        temp = a;
        a = b;
        b = temp;
    }
    float sum = 0;
    float avg = 0;
    int count = 0;
    for(int i = a;i <= b;i++) {
        if(i % 3 == 0 || i % 5 == 0) {
            sum += i;
            count++;
        }
    }
    avg = sum / count;
    printf("sum : %.0f\navg : %.1f", sum,avg);
    return 0;
}
