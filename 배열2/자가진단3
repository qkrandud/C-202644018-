#include <stdio.h>
int main()
{
    int num1 = 100;
    int num2;
    scanf("%d", &num2);
    printf("%d %d ", num1, num2);

    while (num1 - num2 >= 0)
    {
        printf("%d ", num1 - num2);
        int temp = num1 - num2;
        num1 = num2;
        num2 = temp;
    }
    printf("%d", num1 - num2);
    return 0;
}
