#include <stdio.h>

int main()
{
    int arr[10] = {0};
    int max = 0;
    int min = 0;

    for (int i = 0; i < 10; i++)
    {
        scanf("%d", &arr[i]);

        if (max < arr[i])
        {
            max = arr[i];
        }
        else if (min > arr[i])
        {
            min = arr[i];
        }
    }
    printf("%d %d", max, min);
    return 0;
}
