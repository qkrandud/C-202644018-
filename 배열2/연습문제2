#include <stdio.h>

int main()
{
    int arr[11] = {0};
    int num;
    for (int i = 0; i < 1; i--)
    {
        scanf("%d", &num);
        if (num == 0)
        {
            break;
        }
        else if (num >= 10)
        {
            num %= 10;
        }
        arr[num]++;
    }
    for (int i = 0; i < 11; i++)
    {
        if (arr[i] != 0)
        {
            printf("%d : %d\n", i, arr[i]);
        }
    }
    return 0;
}
