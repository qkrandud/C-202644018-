#include <stdio.h>

int main()
{
    int three = 0;
    int five = 0;
    for (int i = 0; i < 10; i++)
    {
        int num;
        scanf("%d", &num);
        if (num % 3 == 0)
        {
            three++;
            if (num % 5 == 0)
            {
                five++;
            }
        }
        else if (num % 5 == 0)
        {
            five++;
        }
    }
    printf("Multiples of 3 : %d\nMultiples of 5 : %d", three, five);
    return 0;
}
