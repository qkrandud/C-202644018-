#include <stdio.h>

int main()
{
    int arr[100] = {0};
    int max = 0;
    int min = 1000;

    for (int i = 0; i < 100; i++)
    {
        scanf("%d", &arr[i]);

        if (arr[i] == 0)
        {
            break;
        }
        else if (max < arr[i])
        {
            max = arr[i];
        }
        else if (min > arr[i])
        {
            min = arr[i];
        }
    }
    printf("%d", max - min);
    return 0;
}
