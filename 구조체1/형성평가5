#include <iostream>
#include <stdio.h>

struct Student
{
    char name[20];
    int score[3];
    int total;   // 총점
};

void input(struct Student *person,int n)
{
    for(int i = 0; i < n;i++) {
        scanf("%20s",person[i].name);
        for(int j = 0;j < 3;j++) {
            scanf("%d",&person[i].score[j]);
        }
        person[i].total = person[i].score[0] + person[i].score[1] + person[i].score[2];
    }
}

void sort(struct Student *person,int n)
{
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (person[j].total < person[j + 1].total) {
                struct Student temp = person[j];
                person[j] = person[j + 1];
                person[j + 1] = temp;
            }
        }
    }
}

void output(struct Student *person,int n)
{
    for(int i = 0; i < n;i++) {
        printf("%s %d %d %d %d\n",person[i].name,person[i].score[0],person[i].score[1],person[i].score[2],person[i].total);
    }
}

int main() {
    int n;
    scanf("%d",&n);

    struct Student person[3] = {{"",0,0},{"",0,0},{"",0,0}};
    input(person,n);
    sort(person,n);
    output(person,n);
    return 0;
}
