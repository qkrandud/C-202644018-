#include <stdio.h>

int main()
{
    int arr[10] = {0};
    int num;
    for (int i = 0; i < 1; i--)
    {
        scanf("%d", &num);
        if (num == 0)
        {
            break;
        }
        else if (num >= 10)
        {
            arr[num / 10 - 1]++;
        }
        else
        {
            arr[0]++;
        }
    }
    for (int i = 9; i >= 0; i--)
    {
        if (arr[i] != 0)
        {
            printf("%d : %d\n", (i + 1) * 10, arr[i]);
        }
    }
    return 0;
}
