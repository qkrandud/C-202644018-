#include <stdio.h>

int main()
{
    int arr[4][3];

    for (int i = 0; i < 4; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            scanf("%d", &arr[i][j]);
        }
    }
    int sumax = 0;
    for (int i = 0; i < 4; i++)
    {
        int sum = 0;
        for (int j = 0; j < 3; j++)
        {
            sum += arr[i][j];
        }
        printf("%d\n", sum);
        sumax += sum;
    }
    printf("%d", sumax);
    return 0;
}
