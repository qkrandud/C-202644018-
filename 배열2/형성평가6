#include <stdio.h>

int main()
{
    int arr[5][5] = {{1, 0, 1, 0, 1}, {0}, {0}, {0}, {0}};

    for (int i = 1; i < 5; i++)
    {
        if (i % 2 == 1) // 홀수 행: 1, 3열 계산
        {
            for (int j = 1; j < 5; j += 2)
            {
                arr[i][j] = arr[i - 1][j - 1] + arr[i - 1][j + 1];
            }
        }
        else // 짝수 행: 0, 2, 4열 계산 (경계 체크 필수)
        {
            for (int j = 0; j < 5; j += 2)
            {
                int left = (j - 1 >= 0) ? arr[i - 1][j - 1] : 0;
                int right = (j + 1 < 5) ? arr[i - 1][j + 1] : 0;
                arr[i][j] = left + right;
            }
        }
    }

    // 출력
    for (int i = 0; i < 5; i++)
    {
        for (int j = 0; j < 5; j++)
        {
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }

    return 0;
}
