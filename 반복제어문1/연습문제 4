#include <stdio.h>

int main() {
    int num;
    float sum = 0;
    float avg;
    int cnt = 0;
    scanf("%d",&num);

    while(num != 0) {
        cnt++;
        sum += num;
        scanf("%d",&num);
    }
    avg = sum / cnt;
    printf("cnt = %d\nsum = %.0f\navg = %.2f", cnt,sum,avg);

    return 0;
}
