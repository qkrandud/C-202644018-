#include <stdio.h>
#include <string.h>

struct square
{
    int x1;
    int y1;
    int x2;
    int y2;
};

int main()
{
    int x1, y1, x2, y2;
    struct square squares[2] = {{0, 0, 0, 0}, {0, 0, 0, 0}};
    for(int i = 0;i < 2;i++) {
        scanf("%d %d %d %d", &squares[i].x1, &squares[i].y1, &squares[i].x2, &squares[i].y2);
    }

    if(squares[0].x1 <= squares[1].x1) {
        x1 = squares[0].x1;
    }
    else {
        x1 = squares[1].x1;
    }
    if(squares[0].y1 <= squares[1].y1) {
        y1 = squares[0].y1;
    }
    else {
        y1 = squares[1].y1;
    }
    if(squares[0].x2 >= squares[1].x2) {
        x2 = squares[0].x2;
    }
    else {
        x2 = squares[1].x2;
    }
    if(squares[0].y2 >= squares[1].y2) {
        y2 = squares[0].y2;
    }
    else {
        y2 = squares[1].y2;
    }
    printf("%d %d %d %d\n", x1, y1, x2, y2);
    return 0;
}
