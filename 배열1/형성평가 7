#include <stdio.h>

int main()
{
    int arr[100] = {0};
    int count = 0;
    for (int i = 0; i < 100; i++)
    {
        scanf("%d", &arr[i]);
        if (arr[i] == 0)
        {
            printf("%d\n", count);
            break;
        }
        count++;
    }
    for (int i = 0; i < count; i++)
    {
        if (arr[i] % 2 == 1)
        {
            printf("%d ", arr[i] * 2);
        }
        else
        {
            printf("%d ", arr[i] / 2);
        }
    }
    return 0;
}
