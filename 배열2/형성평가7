#include <stdio.h>

int main()
{
    int arr[4][2] = {{16, 27}, {39, 100}, {19, 88}, {61, 20}};

    for (int i = 0; i < 4; i++)
    {
        int sum = 0;
        for (int j = 0; j < 2; j++)
        {
            sum += arr[i][j];
        }
        printf("%d ", sum / 2);
    }
    printf("\n");
    int sumax = 0;

    for (int i = 0; i < 2; i++)
    {
        int sum = 0;
        for (int j = 0; j < 4; j++)
        {
            sum += arr[j][i];
        }
        printf("%d ", sum / 4);
        sumax += sum;
    }
    printf("\n");

    printf("%d", sumax / 8);
    return 0;
}
