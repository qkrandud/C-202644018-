#include <stdio.h>

int main()
{
    int arr[100] = {0};
    int num = 0;
    int count;
    for (int i = 0; i < 100; i++)
    {
        scanf("%d", &num);
        if (num < 1 || num > 10)
        {
            count = i;
            break;
        }
        arr[num]++;
    }
    for (int i = 0; i < 11; i++)
    {
        if (arr[i] != 0)
        {
            printf("%d : %d\n", i, arr[i]);
        }
    }
    return 0;
}
