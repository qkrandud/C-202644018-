#include <stdio.h>

int main()
{
    int arr[10] = {0};
    float even = 0.0;
    float odd = 0.0;
    for (int i = 0; i < 10; i++)
    {
        scanf("%d", &arr[i]);
        if ((i + 1) % 2 == 0)
        {
            even += arr[i];
        }
        else
        {
            odd += arr[i];
        }
    }
    odd /= 5;
    printf("sum : %.0f\navg : %.1f", even, odd);
    return 0;
}
