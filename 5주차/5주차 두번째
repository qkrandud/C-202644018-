#include <stdio.h>

void sorted(int arr[],int n) {
    for (int i = 0;i < n-1;i++) {
        for (int j=0;j < n-i-1;j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }
}

int main() {
    int array[] = {7,4,5,1,3};
    int n = sizeof(array) / sizeof(array[0]);
    printf("초기 상태 배열 : [ ");
    for(int i = 0 ; i < n;i++) {
        printf("%d ",array[i]);
    } 
    printf("]\n");

    printf("정렬된 배열 : [ ");

    sorted(array,n);

    printf("정렬된 배열 : [ ");
    for(int i = 0 ; i < n;i++) {
        printf("%d ",array[i]);
    } 
    printf("]\n");

    return 0;
}
