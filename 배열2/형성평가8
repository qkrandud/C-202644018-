#include <stdio.h>

int main()
{
    int arr[6][6] = {{0}, {0}, {0}, {0}, {0}, {0}};

    for (int i = 0; i < 6; i++)
    {
        arr[i][i] = 1;
        arr[i][0] = 1;
    }
    for (int i = 2; i < 6; i++)
    {
        for (int j = 1; j < i; j++)
        {
            arr[i][j] = arr[i - 1][j - 1] + arr[i - 1][j];
        }
    }
    for (int i = 5; i >= 0; i--)
    {
        for (int j = 0; j < i + 1; j++)
        {
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }
    return 0;
}
