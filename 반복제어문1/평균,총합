#include <stdio.h>

int main() {
    float sum = 0;
    float num;
    int count = 0;
    float avg = 0.0;
    for(int i = 0; i < 5;i--) {
        count++;
        scanf("%f",&num);
        if(num == 0) {
            break;
        }
        sum += num;
    }
    avg = sum / count;
    printf("sum : %.0f\n",sum);
    printf("avg : %.1f",avg);

    return 0;
}
