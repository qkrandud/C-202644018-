#include <stdio.h>

union Data {
    int i;
    char bytes[4];
};

int main(void) {
    union Data d;

    d.i = 0x12345678;

    printf("정수로 읽기: 0x%X\n", d.i);
    printf("첫 번째 바이트만 읽기: 0x%X\n", (unsigned char)d.bytes[0]);
    printf("전체 크기: %zu 바이트\n", sizeof(d));

    return 0;
}

