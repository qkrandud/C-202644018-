#include <stdio.h>

int main()
{
    int arr[100] = {0};
    int zero;

    for (int i = 0; i < 100; i++)
    {
        scanf("%d", &arr[i]);

        if (arr[i] == 0)
        {
            zero = i;
            break;
        }
    }
    for (int i = zero - 1; i >= 0; i--)
    {
        printf("%d ", arr[i]);
    }
    return 0;
}
