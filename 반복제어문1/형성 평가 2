#include <stdio.h>

int main() {
    int num;
    int odd,even  = 0;
    scanf("%d",&num);
    while (num != 0) {
        if(num % 2 != 0) {
            odd++;
        }
        else {
            even++;
        }
        scanf("%d",&num);
    }
    printf("odd : %d\n",odd);
    printf("even : %d\n",even);

    return 0;
}
