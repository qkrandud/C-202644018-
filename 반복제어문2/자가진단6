#include <stdio.h>

int main()
{
    int n;
    float sum = 0;
    float avg = 0;
    scanf("%d", &n);
    for (int i = 0; i < n; i++)
    {
        int score;
        scanf("%d", &score);
        sum += score;
    }
    avg = sum / n;
    printf("avg : %.1f\n", avg);
    if (avg > 80)
    {
        printf("pass");
    }
    else
    {
        printf("fail");
    }
    return 0;
}
