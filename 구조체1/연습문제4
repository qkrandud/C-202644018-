#include <stdio.h>
#include <string.h>

struct Person
{
    char name[21];
    int score;
};

int main()
{
    struct Person person[5] = {{"",0},{"",0},{"",0},{"",0},{"",0}};
    int max_score = 0;
    char max_name[21] = "";

    for (int i = 0; i < 5;i++) {
        scanf("%20s %d", person[i].name, &person[i].score);
        if (person[i].score > max_score) {
            max_score = person[i].score;
            strcpy(max_name, person[i].name);
        }
    }

    printf("%s %d\n", max_name, max_score);

    return 0;
}
